{
  "expo": {
    "name": "Vincere",
    "slug": "vincere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vincere",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vincere.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vincere uses your location to track runs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Vincere uses your location to track runs in background.",
        "NSHealthShareUsageDescription": "Vincere reads health data to personalize your training.",
        "NSHealthUpdateUsageDescription": "Vincere writes workout data to Apple Health.",
        "NSMotionUsageDescription": "Vincere uses motion data to analyze your running form."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.vincere.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "apiUrl": "http://localhost:8000",
      "stravaClientId": "216298"
    }
  }
}
