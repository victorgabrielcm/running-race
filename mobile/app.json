{
  "expo": {
    "name": "Vincere",
    "slug": "vincere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vincere",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vincere.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Vincere usa sua localização para gravar suas corridas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O Vincere usa sua localização em segundo plano para gravar suas corridas sem interrupção.",
        "NSLocationAlwaysUsageDescription": "O Vincere usa sua localização em segundo plano para gravar suas corridas sem interrupção.",
        "NSHealthShareUsageDescription": "O Vincere lê dados de saúde para personalizar seu treinamento.",
        "NSHealthUpdateUsageDescription": "O Vincere grava treinos no Apple Health.",
        "NSMotionUsageDescription": "O Vincere usa dados de movimento para analisar sua forma de corrida.",
        "UIBackgroundModes": ["location", "fetch"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.vincere.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita o Vincere acessar sua localização para gravar suas corridas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#CCFF00",
          "defaultChannel": "vincere",
          "sounds": []
        }
      ],
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "apiUrl": "http://localhost:8000",
      "stravaClientId": "216298"
    }
  }
}
