# Strava OAuth
STRAVA_CLIENT_ID=216298
STRAVA_CLIENT_SECRET=your-strava-client-secret

# AI provider: "groq" (free) ou "anthropic" (pago)
AI_PROVIDER=groq

# Groq — grátis, Llama 3.3 70B. Pegue a key em https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (só precisa se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# Infra
DATABASE_URL=postgresql+asyncpg://vincere:vincere@db:5432/vincere
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=*
